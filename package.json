{
  "name": "moi-tracker",
  "version": "1.3.0",
  "description": "Moi Tracker - மொய் கணக்கு | Function moi and gift accounting software",
  "author": "Dhineshkumar Adpc Murugan Trader",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis --x64 --ia32 --publish never"
  },
  "build": {
    "appId": "shop.adpc.moitracker",
    "productName": "Moi Tracker",
    "copyright": "Copyright © 2026 Dhineshkumar Adpc Murugan Trader",
    "compression": "maximum",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "pdfart.js",
      "icon.png",
      "pictures/**/*",
      "node_modules/**/*"
    ],
    "extraMetadata": {
      "description": "Moi Tracker - function moi and gift accounting software"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "icon.png",
      "legalTrademarks": "Dhineshkumar Adpc Murugan Trader",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Moi Tracker",
      "uninstallDisplayName": "Moi Tracker",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false,
      "license": "build/license.txt",
      "include": "build/installer.nsh",
      "artifactName": "MoiTracker-Setup.exe"
    }
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "24.13.3"
  }
}
